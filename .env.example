APP_ENV=development
APP_BASE_URL=http://localhost:8000
APP_SECRET=replace-with-at-least-32-random-characters
DATABASE_PATH=data/nerkhban.db
# Ignore HTTP_PROXY/ALL_PROXY for marketplace requests by default.
MARKETPLACE_TRUST_ENV=false

# Create a public app in the Basalam developer panel.
BASALAM_CLIENT_ID=
BASALAM_CLIENT_SECRET=
BASALAM_REDIRECT_URI=http://localhost:8000/auth/basalam/callback
BASALAM_SCOPES=vendor.profile.read vendor.product.read vendor.product.write

# Configure this secret in the App Store subscription webhook URL/header.
WEBHOOK_SECRET=replace-me
# Used by a scheduler to invoke POST /internal/reprice.
CRON_SECRET=replace-me

# Public market search works without OAuth credentials.
DEMO_MODE=false

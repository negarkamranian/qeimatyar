# Public hostname only; do not include https:// or a trailing slash.
DOMAIN=app.example.com

APP_ENV=production
APP_BASE_URL=https://app.example.com
APP_SECRET=GENERATE_A_RANDOM_SECRET
DATABASE_PATH=/app/data/nerkhban.db
# Set true only when the server must reach marketplaces through its configured proxy.
MARKETPLACE_TRUST_ENV=false

BASALAM_CLIENT_ID=
BASALAM_CLIENT_SECRET=
BASALAM_REDIRECT_URI=https://app.example.com/auth/basalam/callback
BASALAM_SCOPES=vendor.profile.read vendor.product.read
MERCHANT_PRODUCT_LIMIT=50
MERCHANT_SYNC_HOURS=6

WEBHOOK_SECRET=GENERATE_A_DIFFERENT_RANDOM_SECRET
CRON_SECRET=GENERATE_A_DIFFERENT_RANDOM_SECRET

# Market search works without OAuth credentials. Merchant dashboards require OAuth.
DEMO_MODE=false
